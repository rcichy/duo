{
  "env": { "DUO_HOME": "__DUO_HOME__", "DUO_MODEL": "gpt-5.3-codex-high", "DUO_MAX_ROUNDS": "3" },
  "hooks": {
    "PreToolUse": [
      { "matcher": "ExitPlanMode", "hooks": [ { "type": "command", "command": "__HOME__/.config/ai/duo/hooks/review-plan.sh", "timeout": 600, "statusMessage": "duo: Cursor is reviewing the plan…" } ] },
      { "matcher": "Bash",         "hooks": [ { "type": "command", "command": "__HOME__/.config/ai/duo/hooks/block-git-staging.sh" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "__HOME__/.config/ai/duo/hooks/review-diff.sh", "timeout": 900, "statusMessage": "duo: Cursor is reviewing the diff…" } ] }
    ]
  }
}
